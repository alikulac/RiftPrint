												<core:layoutData>
													<FlexItemData id="idFlexItem1Row2Day3" growFactor="1"/>
												</core:layoutData>
											</core:Icon>
											<HBox id="idHBoxRow2Day3" direction="RowReverse" width="4em" class="sapUiTinyMarginEnd">
												<Label id="idWrkCtrCapDay3OperatingHours" design="{= ${WrkCtrCapDay3NmbrOfCapModified} === 'X' ? 'Bold' : 'Standard'}"
