							</customData>
							<Text id="idDay7Text" text="{i18nLib>SundayText}"/>
						</Column>
					</columns>
					<items>
						<ColumnListItem press="handleRowPress" id="idWorkCenterCapColListItems">
							<cells xmlns="sap.m">
								<ObjectIdentifier id="idWorkCenterField"
									title="{parts:['WorkCenter','Plant','UIElementStates>/bNeedPlantInfo'],formatter: '.concatWorkCenterAndPlant'}"
									titlePress="handleChangeWorkCenterInNewTab" titleActive="{UIElementStates>/bChangeWorkCenterSupported}"/>
								<Text id="idShiftsDefinitionSmartField" text="{parts:['ShiftDefinition','ShiftDefinitionName'],formatter: '.selectShiftName'}"/>
								<smartField:SmartField value="{ShiftStartTime}" id="idShiftsStartTimeSmartField" enabled="false"/>
								<smartField:SmartField value="{ShiftEndTime}" id="idShiftsEndTimeSmartField" enabled="false"/>
								<VBox id="idVBoxDay1" width="8em" class="sapUiSmallMarginEnd">
									<FlexBox id="idFlexBoxRow1Day1" direction="Row" alignItems="Center" height="3em" alignContent="Center" justifyContent="Center"
										visible="{= parseFloat(${WrkCtrCapDay1OperatingHours}).toFixed(2) !== '0.00'}">
										<items>
											<core:Icon id="idIconRow1Day1" color="Neutral" width="2em" src="sap-icon://person-placeholder" tooltip="{i18nLib>ResourcesText}">
												<core:layoutData>
													<FlexItemData id="idFlexItem1Row1Day1" growFactor="1"/>
												</core:layoutData>
											</core:Icon>
											<HBox id="idHBoxRow1Day1" direction="RowReverse" width="4em" class="sapUiTinyMarginEnd" alignItems="Center" alignContent="Center"
