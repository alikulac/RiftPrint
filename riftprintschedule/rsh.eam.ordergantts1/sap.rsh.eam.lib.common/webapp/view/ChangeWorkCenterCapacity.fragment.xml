							</customData>
							<Text id="idDay5Text" text="{i18nLib>FridayText}"/>
						</Column>
						<Column id="idDay6Col" width="10em">
							<customData>
								<core:CustomData key="p13nData"
									value='\{"columnKey":"WrkCtrCapDay6NmbrOfCapacities","additionalProperty":"WrkCtrCapDay6OperatingHours,WrkCtrCapDay6NmbrOfCapModified","type":"string", "columnIndex":"9", "leadingProperty":["WrkCtrCapDay6NmbrOfCapacities"]}'/>
							</customData>
							<Text id="idDay6Text" text="{i18nLib>SaturdayText}"/>
						</Column>
						<Column id="idDay7Col" width="10em">
