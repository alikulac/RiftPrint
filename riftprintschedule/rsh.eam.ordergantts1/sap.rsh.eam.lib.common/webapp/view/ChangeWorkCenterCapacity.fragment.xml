												justifyContent="End">
												<StepInput id="idWrkCtrCapDay4Nmbr" value="{WrkCtrCapDay4NmbrOfCapacities}" validationMode="LiveChange" min="0" max="999"
													change="handleCapacityDay4FieldChange" textAlign="Right" width="1em" ariaLabelledBy="idDay4Col"
