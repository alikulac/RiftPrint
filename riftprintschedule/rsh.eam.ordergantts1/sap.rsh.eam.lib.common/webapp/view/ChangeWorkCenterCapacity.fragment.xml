													<FlexItemData id="idFlexItem3Row2Day1" growFactor="2"/>
												</layoutData>
											</Label>
										</items>
									</FlexBox>
									<FlexBox id="idFlexBoxRow3Day1" direction="Row" alignItems="Center" alignContent="Center" justifyContent="Center"
										visible="{= parseFloat(${WrkCtrCapDay1OperatingHours}).toFixed(2) === '0.00'}">
										<items>
											<Label id="idNoShiftDay1" text="{i18nLib>NoShiftText}" width="100%"/>
										</items>
									</FlexBox>
								</VBox>
								<VBox id="idVBoxDay2" width="8em" class="sapUiSmallMarginEnd">
									<FlexBox id="idFlexBoxRow1Day2" direction="Row" alignItems="Center" height="3em" alignContent="Center" justifyContent="Center"
