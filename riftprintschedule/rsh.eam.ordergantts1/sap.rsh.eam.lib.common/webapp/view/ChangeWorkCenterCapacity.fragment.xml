											<core:Icon id="idIconRow2Day2" color="Neutral" width="2em" src="sap-icon://history" tooltip="{i18nLib>HoursText}">
												<core:layoutData>
													<FlexItemData id="idFlexItem1Row2Day2" growFactor="1"/>
												</core:layoutData>
											</core:Icon>
											<HBox id="idHBoxRow2Day2" direction="RowReverse" width="4em" class="sapUiTinyMarginEnd">
												<Label id="idWrkCtrCapDay2OperatingHours" design="{= ${WrkCtrCapDay2NmbrOfCapModified} === 'X' ? 'Bold' : 'Standard'}"
													text="{parts: ['WrkCtrCapDay2OperatingHours', 'WrkCtrCapDay2NmbrOfCapacities', 'WorkCenterCapacityUnit'], formatter: '.formatCapHours'}"/>
												<layoutData>
