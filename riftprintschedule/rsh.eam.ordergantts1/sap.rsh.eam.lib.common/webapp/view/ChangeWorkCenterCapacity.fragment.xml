													enabled="{path: 'WrkCtrCapDay2NmbrOfCapFldCtrl', formatter: '.isWrkCtrCapStepInputFieldEnabled'}" class="sapUiTinyNegativeMarginBeginEnd"/>
												<layoutData>
													<FlexItemData id="idFlexItem2Row1Day2" growFactor="1"/>
												</layoutData>
											</HBox>
										</items>
									</FlexBox>
									<FlexBox id="idFlexBoxRow2Day2" direction="Row" alignItems="Center" height="2em" alignContent="Center" justifyContent="Center"
