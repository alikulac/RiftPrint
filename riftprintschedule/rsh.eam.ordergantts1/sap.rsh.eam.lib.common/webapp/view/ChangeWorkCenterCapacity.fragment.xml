											<HBox id="idHBoxRow2Day1" direction="RowReverse" width="4em" class="sapUiTinyMarginEnd">
												<Label id="idWrkCtrCapDay1OperatingHours" design="{= ${WrkCtrCapDay1NmbrOfCapModified} === 'X' ? 'Bold' : 'Standard'}"
