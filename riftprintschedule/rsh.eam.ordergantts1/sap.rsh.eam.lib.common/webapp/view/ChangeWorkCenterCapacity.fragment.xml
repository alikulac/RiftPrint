<core:FragmentDefinition id="idOpSchedSessionFD" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form"
	xmlns:unified="sap.ui.unified" xmlns:cal="sap.ui.unified.calendar" xmlns:layout="sap.ui.layout"
	xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" xmlns:smartTable="sap.ui.comp.smarttable"
	xmlns:smartField="sap.ui.comp.smartfield">
	<Dialog id="idWorkCenterCapChange" title="{UIElementStates>/sTitle}" resizable="true" draggable="true"
		afterClose="onAfterDialogClose" contentWidth="110rem">
		<content>
			<f:Form id="idOpSchedSessionForm" editable="true">
				<f:layout>
					<f:ResponsiveGridLayout id="idWorkCenterCapRGLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false"
						emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="2"/>
				</f:layout>
				<f:formContainers>
					<f:FormContainer id="idWorkCenterCapFormContainer">
						<f:FormElement id="idWorkCenterCapFilledFE">
							<f:fields>
								<layout:VerticalLayout id="idVLWorcCenterCapacity">
									<Label id="idWeekSelectionLabel" labelFor="idWeekSelectionDatePicker" text="{i18nLib>WeekSelectionLabel}" wrapping="true"/>
									<FlexBox id="idFlexBoxDatePicker" width="40%">
										<items>
											<DatePicker id="idTargetWeekDatePicker" change="handleTargetWeekSelected" value="{UIElementStates>/sWeekSelectedText}"
												editable="{UIElementStates>/bTargetWeekEditable}" valueState="{UIElementStates>/sTargetWeekDatePickerValueState}"
												valueStateText="{UIElementStates>/sTargetWeekDatePickerValueStateText}">
												<specialDates>
													<unified:DateTypeRange type="Type16" startDate="{= ${UIElementStates>/dWeekSelectionStartDate}}"
														endDate="{= ${UIElementStates>/dWeekSelectionEndDate}}" id="idWeekSelectionDtDTR"/>
												</specialDates>
												<layoutData>
													<FlexItemData id="idFlexItem1Row1" growFactor="1"/>
												</layoutData>
											</DatePicker>
											<HBox id="idHBoxPagination" direction="Row" class="sapUiTinyMarginEnd" justifyContent="SpaceBetween">
												<Button id="idPrevWeek" type="Transparent" icon="sap-icon://nav-back" tooltip="{i18nLib>PrevWeekTooltip}"
													press="onPrevWeekNavigationButtonPress" enabled="{UIElementStates>/bPrevWeekEnabled}"></Button>
												<Button id="idNextWeek" type="Transparent" icon="sap-icon://feeder-arrow" tooltip="{i18nLib>NextWeekTooltip}"
													press="onNextWeekNavigationButtonPress" enabled="{UIElementStates>/bNextWeekEnabled}"></Button>
											</HBox>
										</items>
									</FlexBox>
								</layout:VerticalLayout>
							</f:fields>
						</f:FormElement>
					</f:FormContainer>
				</f:formContainers>
			</f:Form>
			<smartTable:SmartTable id="idWorkCenterCapChangeList" tableType="ResponsiveTable" height="80%" beforeRebindTable="onBeforeRebindTable"
				entitySet="C_RSHWorkCenterCapacityChangeSet" useVariantManagement="false" showRowCount="false" useTablePersonalisation="false"
				useExportToExcel="false" enableAutoBinding="false" persistencyKey="pKeyWorkCenterCapList" noData="{i18nLib>NoDataTextForWC}"
				initialise="onTableInitialized" initialNoDataText="{i18nLib>NoDataTextForWC}" demandPopin="true"
				requestAtLeastFields="ShiftDefinitionName,ShiftDefinition,Plant,WorkCenterCapacityUnit,WrkCtrCapDay1NmbrOfCapFldCtrl,WrkCtrCapDay2NmbrOfCapFldCtrl,WrkCtrCapDay3NmbrOfCapFldCtrl,WrkCtrCapDay4NmbrOfCapFldCtrl,WrkCtrCapDay5NmbrOfCapFldCtrl,WrkCtrCapDay6NmbrOfCapFldCtrl,WrkCtrCapDay7NmbrOfCapFldCtrl"
				ignoreFromPersonalisation="WrkCtrCapDay1NmbrOfCapFldCtrl,WrkCtrCapDay2NmbrOfCapFldCtrl,WrkCtrCapDay3NmbrOfCapFldCtrl,WrkCtrCapDay4NmbrOfCapFldCtrl,WrkCtrCapDay5NmbrOfCapFldCtrl,WrkCtrCapDay6NmbrOfCapFldCtrl,WrkCtrCapDay7NmbrOfCapFldCtrl">
				<smartTable:layoutData>
					<FlexItemData id="idWorkCenterCapListFlexItemData" growFactor="1" baseSize="0%"/>
				</smartTable:layoutData>
				<smartTable:customToolbar>
					<OverflowToolbar id="idWCCapOverflowToolbar" design="Transparent" visible="false">
						<ToolbarSpacer id="idWCCapTBSpacer"></ToolbarSpacer>
					</OverflowToolbar>
				</smartTable:customToolbar>
				<Table mode="None" id="idWorkCenterCapChangeTable" noDataText="{i18nLib>NoDataTextForWC}">
					<columns>
						<Column id="idWorkCenter" width="6rem" mergeDuplicates="true" mergeFunctionName="getTitle">
							<customData>
								<core:CustomData key="p13nData"
									value='\{"columnKey": "WorkCenter", "type": "string", "columnIndex":"0", "leadingProperty":["WorkCenter"], "filterProperty": "WorkCenter", "sortProperty":"WorkCenter"}'/>
							</customData>
							<Text id="idWorkCenterText" text="{/#C_RSHWorkCenterCapacityChangeType/WorkCenter/@sap:label}"/>
						</Column>
						<Column id="idShiftDefinition" width="6rem" visible="{= ${UIElementStates>/bHasShiftData}}">
							<customData>
								<core:CustomData key="p13nData"
									value='\{"columnKey": "ShiftDefinitionName", "type":"string", "columnIndex":"1", "leadingProperty":["ShiftDefinitionName"]}'/>
							</customData>
							<Text id="idShiftDefinitionText" text="{i18nLib>ShiftsText}"/>
						</Column>
						<Column id="idShiftsStartCol" width="6rem">
							<customData>
								<core:CustomData key="p13nData"
									value='\{"columnKey": "ShiftStartTime", "type":"string", "columnIndex":"2", "leadingProperty":["ShiftStartTime"]}'/>
							</customData>
							<Text id="idShiftsStartText" text="{i18nLib>ShiftsStartText}"/>
						</Column>
						<Column id="idShiftsEndCol" width="6rem">
							<customData>
								<core:CustomData key="p13nData"
									value='\{"columnKey": "ShiftEndTime", "type":"string", "columnIndex":"3", "leadingProperty":["ShiftEndTime"]}'/>
							</customData>
							<Text id="idShiftsEndText" text="{i18nLib>ShiftsEndText}"/>
						</Column>
						<Column id="idDay1Col" width="10em">
							<customData>
								<core:CustomData key="p13nData"
									value='\{"columnKey":"WrkCtrCapDay1NmbrOfCapacities","additionalProperty":"WrkCtrCapDay1OperatingHours,WrkCtrCapDay1NmbrOfCapModified","type":"string", "columnIndex":"4", "leadingProperty":["WrkCtrCapDay1NmbrOfCapacities"]}'/>
							</customData>
							<Text id="idDay1Text" text="{i18nLib>MondayText}"/>
						</Column>
						<Column id="idDay2Col" width="10em">
							<customData>
								<core:CustomData key="p13nData"
									value='\{"columnKey":"WrkCtrCapDay2NmbrOfCapacities","additionalProperty":"WrkCtrCapDay2OperatingHours,WrkCtrCapDay2NmbrOfCapModified","type":"string", "columnIndex":"5", "leadingProperty":["WrkCtrCapDay2NmbrOfCapacities"]}'/>
							</customData>
							<Text id="idDay2Text" text="{i18nLib>TuesdayText}"/>
						</Column>
						<Column id="idDay3Col" width="10em">
