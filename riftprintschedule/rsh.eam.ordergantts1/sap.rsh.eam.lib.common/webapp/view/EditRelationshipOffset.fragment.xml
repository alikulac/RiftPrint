<core:FragmentDefinition id="idFragRelMenu" xmlns="sap.m" xmlns:core="sap.ui.core">
	<ResponsivePopover id="idEditOffsetPopover" class="sapUiContentPadding" placement="PreferredBottomOrFlip" afterClose="onPopoverClose">
		<customHeader>
			<Toolbar>
				<Button id="idBackNavigation" icon="sap-icon://nav-back" press="onNavBackPress"></Button>
				<Title id="idOffsetTitle" text="{i18nLib>EditOffset}"></Title>
			</Toolbar>
		</customHeader>
		<beginButton>
			<Button id="idOkBtn" text="{i18nLib>Ok}" type="Emphasized" press="onSubmit" enabled="false"/>
		</beginButton>
		<endButton>
			<Button id="idCancelBtn" text="{i18nLib>Cancel}" press="onCancel"/>
		</endButton>
		<content>
			<HBox id="idHBoxEditOffset" justifyContent="SpaceBetween">
				<Input id="idOffsetInput" textAlign="Right" width="95%" liveChange="onOffsetChange"/>
				<Select id="idOffsetUnit" showSecondaryValues="false" change="onUnitChange" items="{ path: 'data>/C_RSHUnitOfMeasureTimeVH'}" selectedKey="{EditRelationshipOffset>/sUnitOfMeasure}">
					<core:ListItem key="{data>UnitOfMeasure}" text="{parts: ['data>UnitOfMeasureLongName' , 'data>UnitOfMeasure'], formatter: '.formatter.formatDurationUnit'}" />
				</Select>
			</HBox>
		</content>
	</ResponsivePopover>
</core:FragmentDefinition>
