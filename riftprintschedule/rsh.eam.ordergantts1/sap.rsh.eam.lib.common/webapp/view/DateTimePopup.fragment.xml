<core:FragmentDefinition id="idDateMenu" xmlns="sap.m" xmlns:core="sap.ui.core">
	<ResponsivePopover id="idDateTimePopover" class="sapUiContentPadding" placement="PreferredBottomOrFlip" afterClose="onPopoverClose">
		<customHeader>
			<Toolbar>
				<Title id="idDateTimePopupTitle" text="{i18nLib>DateTimePopupTitle}"></Title>
			</Toolbar>
		</customHeader>
		<beginButton>
			<Button id="idDateTimePopupOkBtn" text="{i18nLib>Ok}" type="Emphasized" press="onSubmit" enabled="false"/>
		</beginButton>
		<endButton>
			<Button id="idDateTimePopupCancelBtn" text="{i18nLib>Cancel}" press="onCancel"/>
		</endButton>
		<content>
			<HBox id="idHBoxEditDate" width="100%" justifyContent="Center">
				<DateTimePicker id="idDateTimePicker" change="onDateChange" afterValueHelpOpen="afterValueHelpOpen"
					afterValueHelpClose="afterValueHelpClose"
					value="{type:'sap.ui.model.type.DateTime', formatOptions: { style: 'medium', strictParsing: true}}"/>
			</HBox>
		</content>
	</ResponsivePopover>
</core:FragmentDefinition>
