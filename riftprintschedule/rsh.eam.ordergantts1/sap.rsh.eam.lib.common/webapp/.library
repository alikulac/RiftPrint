<?xml version="1.0" ?>
<library xmlns="http://www.sap.com/sap.ui.library.xsd">
    <name>sap.rsh.eam.lib.common</name>
    <vendor>SAP SE</vendor>
    <version>12.0.22</version>
    <copyright>Copyright (C) 2009-2023 SAP SE or an SAP affiliate company. All rights reserved.</copyright>
    <title>>{{title}}</title>
    <documentation>RSH EAM Reuse Library</documentation>
	<appData>
	    <manifest xmlns="http://www.sap.com/ui5/buildext/manifest" >
	        <i18n> messagebundle.properties</i18n>
	        <offline>false</offline>
	        <deviceTypes desktop="true" phone="true" tablet="true" />
	        	<contentDensities cozy="true" compact="true" />
	        <sap.fiori>
	            <registrationId></registrationId>
	            <archeType>reusecomponent</archeType>
	        </sap.fiori>
	        <sap.platform.abap>
	            <uri>/sap/bc/ui5_ui5/sap/undefined</uri>
	        </sap.platform.abap>
	        <sap.platform.hcp>
	            <uri></uri>
	        </sap.platform.hcp>
	    </manifest>
	    <ownership xmlns="http://www.sap.com/ui5/buildext/ownership">
	        <component>CA-RSH-EAM</component>
	    </ownership>
  </appData>

	<dependencies>
		<dependency>
			<libraryName>sap.ui.core</libraryName>
		</dependency>
	</dependencies>
</library>