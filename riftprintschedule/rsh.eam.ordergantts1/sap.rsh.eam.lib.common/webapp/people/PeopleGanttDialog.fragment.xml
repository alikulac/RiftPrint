<core:FragmentDefinition id="idPeopleGanttFragDef" xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:gantt="sap.gantt.simple">
	<Dialog id="idPeopleGanttDialog" draggable="true" resizable="true" contentWidth="100%" contentHeight="50%" afterClose="onAfterClose">
		<content>
			<gantt:GanttChartContainer id="idResourceGanttContainer" enableTimeScrollSync="true" customSettingChange="onCustomSettingChange"/>
		</content>
		<beginButton>
			<Button id="idSaveAssignmentsButton" text="{i18nLib>SaveButtonText}" press="onSave" type="Emphasized" enabled="false"/>
		</beginButton>
		<endButton>
			<Button id="idCloseDialogButton" text="{i18nLib>CancelButtonText}" press="onClose"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
