<core:FragmentDefinition id="idFragOpContextMenu" xmlns="sap.m" xmlns:core="sap.ui.core">
	<ActionSheet id="idOpActionSheet" placement="PreferredBottomOrFlip">
		<Button id="idButtonChangeAction" text="{i18n>ChangeOperationButtonText}" press="onChangeOperationsButton" type="Transparent"/>
		<Button id="idButtonDispatchAction" text="{i18n>DispatchButtonText}" press="onDispatchButton" type="Transparent"/>
		<Button id="idButtonCancDispatchAction" text="{i18n>CancelDispatchButtonText}" press="onCancDispatchButton" type="Transparent"/>
		<Button id="idButtonRemoveConstraintsAction" text="{i18n>RemoveConstraintsButtonText}" press="onRemoveConstraintsButton"
			type="Transparent"/>
		<Button id="idButtonAssignAction" text="{i18n>AssignPeopleButtonText}" type="Transparent" press="onAssignButton"/>
		<Button id="idButtonUnassignAction" text="{i18n>UnassignPeopleButtonText}" type="Transparent" press="onUnassignButton"/>
	</ActionSheet>
</core:FragmentDefinition>