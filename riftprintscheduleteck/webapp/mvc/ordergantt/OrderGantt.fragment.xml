<core:FragmentDefinition
	xmlns="sap.gantt.simple"
	xmlns:m="sap.m"
	xmlns:table="sap.ui.table"
	xmlns:layout="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:navpopover="sap.ui.comp.navpopover"
	xmlns:gnt-cal="sap.gantt.def.cal"
	xmlns:ordergantt="rsh.eam.ordergantts1.mvc.ordergantt"
	xmlns:plugins="sap.ui.table.plugins">
	<GanttChartWithTable id="idOrderGanttChartWithTable" ghostAlignment="Start" adhocLineLayer="Bottom" enableAdhocLine="false"
						 nowLineInUTC="false" shapeOverRelationship="false" dragOrientation="Horizontal" enableSelectAndDrag="false"
						 shapeSelectionMode="MultiWithKeyboardAndLasso" shapeConnect="onRelationshipCreate" shapeDrop="onDragAndDrop"
						 showShapeTimeOnDrag="false" shapeContextMenu="onShapeContextMenu" visibleHorizonUpdate="onVisibleHorizonUpdate"
						 selectOnlyGraphicalShape="true" enableChartOverflowToolbar="true"
						 shapeSelectionChange="onShapeSelectionChange"
						 shapeHighlightSettings="{color:'black', strokeWidth:1, strokeDasharray:'5,1', fillOpacity: 0.3, shapeColor:'blue'}" findByOperator="OR"
						 findBy="MaintenanceOrder,MaintenanceOrderDesc,FunctionalLocation,FunctionalLocationName,Equipment,EquipmentName,MainWorkCenter,OperationDescription,OperationPersonRespName,WorkCenter">
		<overflowToolbarItems>
			<core:Fragment fragmentName="rsh.eam.ordergantts1.mvc.ordergantt.toolbar.ToolbarButtons" type="XML"/>
		</overflowToolbarItems>
		<table>
			<table:TreeTable id="idOrderTreeTable" visibleRowCountMode="Auto" minAutoRowCount="1" rowActionCount="1" enableColumnReordering="false"
							 rowSelectionChange="onOrderTableSelectRows" columnVisibility=".onColumnVisibilityChanged" columnResize=".onColumnResize"
							 firstVisibleRowChanged="onOrderTableFirstVisibleRowChanged" sort="onOrderTableSort" toggleOpenState="onToggleOpenState" >
				<table:plugins>
					<plugins:MultiSelectionPlugin id="idMultiSelectionPlugin" enableNotification="true" showHeaderSelector="true"
												  selectionChange="onOrderTableSelectRows"/>
				</table:plugins>
				<table:extension>
					<m:OverflowToolbar id="idToolbarOrderGanttTT">
						<m:Title id="idTitleOrderGanttTT" text="{parts: ['i18n>maintenanceOrdersItems', 'UIModel>/rowCount'],formatter: '.formatters.formatMessage'}"/>
						<m:ToolbarSpacer id="idToolbarSpTT"/>
						<m:Button id="idExpandBt" icon="sap-icon://expand" press="onExpandSelectedOrders" tooltip="{i18n>expand}" type="Transparent" enabled="false"></m:Button>
						<m:Button id="idCollapseBt" icon="sap-icon://collapse" press="onCollapseSelectedOrders" tooltip="{i18n>collapse}" type="Transparent" enabled="false"></m:Button>
						<m:Button id="idColumnSettingsBtn" icon="sap-icon://action-settings" press=".onColumnSettingsPress" tooltip="{i18nLib>ColumnSettings}"
								  type="Transparent"></m:Button>
					</m:OverflowToolbar>
				</table:extension>
				<table:rowSettingsTemplate>
					<ordergantt:CustomRowSettings id="OrderGntRowStgID" rowId="{OrderOperationRowID}"
													 shapes4="{path:'to_UtilIndicator', templateShareable: true}" relationships="{path:'to_Relationships', templateShareable: true}">
						<ordergantt:shapes1>
							<BaseConditionalShape id="idBaseCondShape" activeShape="{= ${OrderOperationRowLevel} > 0 ? 1 : 0 }">
								<shapes>
									<BaseGroup id="idBaseGroupOrder" shapeId="{OrderOperationRowID}"
											   draggable="{parts: ['MaintenanceOrderSubOperation', 'ProcessingStatus'], formatter: '.formatters.isDNDPossible'}"
											   selectable="{path: 'ProcessingStatus', formatter: '.formatters.isSelectable'}" highlightable="true">
										<shapes>
											<BaseChevron id="idBaseShapeOrder" countInBirdEye="true" time="{OrderStartDateTime}"
														 endTime="{OrderEndDateTime}" hoverable="true"
														 title="{parts: ['MainWorkCenter', 'MaintenanceOrderDesc', 'OrderType', 'MaintPriorityDesc', '', 'MaintenanceOrder' , 'MaintenanceRevision', 'UIModel>/orderLabelInside', 'MainWorkCenterPlant'], formatter: '.ganttFormatters.getOrderLabelText'}"
														 showTitle="{= !${UIModel>/bLabelsToggleBtnOn} ? false : ${UIModel>/orderLabelInside} !== 'NoLabel-Inside' ? true : false }"
														 titleColor="@sapUiContentContrastTextColor"
														 tooltip="{parts: ['MainWorkCenter', 'MaintenanceOrderDesc', 'OrderType', 'MaintPriorityDesc', '', 'MaintenanceOrder', 'MaintenanceRevision', 'UIModel>/orderLabelInside', 'UIModel>/bLabelsToggleBtnOn', 'MainWorkCenterPlant', 'OrderStartDateTime', 'OrderEndDateTime'], formatter: '.ganttFormatters.getOrderTooltip'}"
														 fill="{path: 'ProcessingStatus', formatter: '.formatters.getColor'}"
														 height="{parts: ['OrderOperationRowLevel', 'UIModel>/condensedModeActive'], formatter: '.ganttFormatters.getShevronHight'}"
														 headWidth="{path: 'UIModel>/condensedModeActive', formatter: '.ganttFormatters.getShevronHeadWidth'}"
														 tailWidth="{path: 'UIModel>/condensedModeActive', formatter: '.ganttFormatters.getShevronTailWidth'}" horizontalTextAlignment="Middle"
														 verticalTextAlignment="Center" fontFamily="'72'" fontWeight="bold" fontSize="{= ${UIModel>/condensedModeActive} ? 10 : 12}"/>
											<BaseText id="idOrderLabelLeft"
													  text="{parts: ['MainWorkCenter', 'MaintenanceOrderDesc', 'OrderType', 'MaintPriorityDesc', 'OrderStartDateTime', 'MaintenanceOrder', 'MaintenanceRevision', 'UIModel>/orderLabelLeft', 'MainWorkCenterPlant'], formatter: '.ganttFormatters.getOrderLabelText'}"
													  time="{OrderStartDateTime}" textAnchor="end" xBias="-14" yBias="-1" isLabel="true"
													  fill="@sapTextColor" visible="{= !${UIModel>/bLabelsToggleBtnOn} ? false : ${UIModel>/orderLabelLeft} !== 'NoLabel-Left' ? true : false}"
													  fontSize="{= ${UIModel>/condensedModeActive} ? 10 : 12}" fontFamily="'72'"/>
											<BaseText id="idOrderLabelRight"
													  text="{parts: ['MainWorkCenter', 'MaintenanceOrderDesc', 'OrderType', 'MaintPriorityDesc', 'OrderEndDateTime', 'MaintenanceOrder', 'MaintenanceRevision', 'UIModel>/orderLabelRight', 'MainWorkCenterPlant'], formatter: '.ganttFormatters.getOrderLabelText'}"
													  time="{OrderEndDateTime}" xBias="14" yBias="-1" isLabel="true" fill="@sapTextColor"
													  visible="{= !${UIModel>/bLabelsToggleBtnOn} ? false : ${UIModel>/orderLabelRight} !== 'NoLabel-Right' ? true : false}"
													  fontSize="{= ${UIModel>/condensedModeActive} ? 10 : 12}" fontFamily="'72'"/>
										</shapes>
									</BaseGroup>
									<BaseGroup id="idBaseGroupOperation" hoverable="true" shapeId="{OrderOperationRowID}"
											   connectable="{parts: ['UIModel>/bRelationshipsToggleBtnOn', 'UIModel>/showExpRel', 'MaintenanceOrderSubOperation', 'ProcessingStatus'], formatter: '.formatters.isConnectable'}"
											   draggable="{parts: ['MaintenanceOrderSubOperation', 'ProcessingStatus'], formatter: '.formatters.isDNDPossible'}"
											   selectable="{path: 'ProcessingStatus', formatter: '.formatters.isSelectable'}" highlightable="true">
										<shapes>
											<BaseRectangle id="idBaseShapeOperation" countInBirdEye="true" hoverable="true"
														   yBias="{= ${UIModel>/bUtilizationsToggleBtnOn} &amp;&amp; ${UIModel>/showUtilizationIndicator} ? 2 : 0}"
														   time="{OrderOperationStartDateTime}"
														   endTime="{OrderOperationEndDateTime}"
														   title="{parts: ['MainWorkCenter', 'NumberOfCapacities', 'OperationDescription', 'OperationPersonRespName', '', 'MaintenanceOrderOperation', 'MaintenanceOrderSubOperation', 'MaintOpExecutionStageName', 'UIModel>/operationLabelInside', 'MainWorkCenterPlant','NumberOfAssignedPersons', 'ConcatenatedAssignedPersonsTxt'], formatter: '.ganttFormatters.getOpLabelText'}"
														   showTitle="{= !${UIModel>/bLabelsToggleBtnOn} ? false : ${UIModel>/operationLabelInside} !== 'NoLabel-Inside' ? true : false}"
														   titleColor="@sapUiContentContrastTextColor"
														   tooltip="{parts: ['MainWorkCenter', 'NumberOfCapacities', 'OperationDescription', 'OperationPersonRespName', '', 'MaintenanceOrderOperation', 'MaintenanceOrderSubOperation', 'MaintOpExecutionStageName', 'UIModel>/operationLabelInside', 'UIModel>/bLabelsToggleBtnOn', 'MainWorkCenterPlant', 'NumberOfAssignedPersons', 'ConcatenatedAssignedPersonsTxt', 'OrderOperationStartDateTime', 'OrderOperationEndDateTime'], formatter: '.ganttFormatters.getOperationTooltip'}"
														   fill="{path: 'ProcessingStatus', formatter: '.formatters.getColor'}"
														   height="{parts: ['OrderOperationRowLevel', 'UIModel>/condensedModeActive'], formatter: '.ganttFormatters.getRectangleHight'}"
														   horizontalTextAlignment="Middle" fontFamily="'72'" verticalTextAlignment="Center" fontWeight="bold"
														   fontSize="{= ${UIModel>/condensedModeActive} ? 10 : 12}"/>
											<BaseText id="idOperationLabelLeft"
													  text="{parts: ['MainWorkCenter', 'NumberOfCapacities', 'OperationDescription', 'OperationPersonRespName', 'OrderOperationStartDateTime', 'MaintenanceOrderOperation', 'MaintenanceOrderSubOperation', 'MaintOpExecutionStageName', 'UIModel>/operationLabelLeft', 'MainWorkCenterPlant', 'NumberOfAssignedPersons', 'ConcatenatedAssignedPersonsTxt'], formatter: '.ganttFormatters.getOpLabelText'}"
													  time="{OrderOperationStartDateTime}" textAnchor="end"
													  xBias="{parts: ['MaintenanceOrderSubOperation', 'UIModel>/bRelationshipsToggleBtnOn', 'UIModel>/showImpRel', 'UIModel>/showExpRel'], formatter: '.formatters.getXBiasForOpBarLeftLabel'}"
													  isLabel="true" fill="@sapTextColor"
													  yBias="{parts: ['MaintenanceOrderSubOperation', 'UIModel>/bRelationshipsToggleBtnOn', 'UIModel>/showImpRel', 'UIModel>/showExpRel', 'UIModel>/bUtilizationsToggleBtnOn', 'UIModel>/showUtilizationIndicator'], formatter: '.formatters.getYBiasForOpBarLabel'}"
													  visible="{= !${UIModel>/bLabelsToggleBtnOn} ? false : ${UIModel>/operationLabelLeft} !== 'NoLabel-Left' ? true : false}"
													  fontSize="{= ${UIModel>/condensedModeActive} ? 10 : 12}" fontFamily="'72'"/>
											<BaseText id="idOperationLabelRight"
													  text="{parts: ['MainWorkCenter', 'NumberOfCapacities', 'OperationDescription', 'OperationPersonRespName', 'OrderOperationEndDateTime', 'MaintenanceOrderOperation', 'MaintenanceOrderSubOperation', 'MaintOpExecutionStageName', 'UIModel>/operationLabelRight', 'MainWorkCenterPlant', 'NumberOfAssignedPersons', 'ConcatenatedAssignedPersonsTxt'], formatter: '.ganttFormatters.getOpLabelText'}"
													  time="{OrderOperationEndDateTime}"
													  xBias="{parts: ['MaintenanceOrderSubOperation', 'UIModel>/bRelationshipsToggleBtnOn', 'UIModel>/showImpRel', 'UIModel>/showExpRel'], formatter: '.formatters.getXBiasForOpBarRightLabel'}"
													  isLabel="true" fill="@sapTextColor"
													  yBias="{parts: ['MaintenanceOrderSubOperation', 'UIModel>/bRelationshipsToggleBtnOn', 'UIModel>/showImpRel', 'UIModel>/showExpRel', 'UIModel>/bUtilizationsToggleBtnOn', 'UIModel>/showUtilizationIndicator'], formatter: '.formatters.getYBiasForOpBarLabel'}"
													  visible="{= !${UIModel>/bLabelsToggleBtnOn} ? false : ${UIModel>/operationLabelRight} !== 'NoLabel-Right' ? true : false}"
													  fontSize="{= ${UIModel>/condensedModeActive} ? 10 : 12}" fontFamily="'72'"/>
										</shapes>
									</BaseGroup>
								</shapes>
							</BaseConditionalShape>
						</ordergantt:shapes1>
						<ordergantt:shapes2>
							<BaseRectangle id="idBaseRectangleCriticalPath" shapeId="{OrderOperationRowID}" fill="@sapNegativeColor" draggable="true" selectable="true"
										   height="{parts: ['OrderOperationRowLevel', 'UIModel>/condensedModeActive'], formatter: '.formatters.getCriticalPathHight'}"
										   yBias="{parts: ['OrderOperationRowLevel', 'UIModel>/condensedModeActive'], formatter: '.formatters.getCPyBiasValue'}"
										   time="{OrderOperationStartDateTime}"
										   endTime="{OrderOperationEndDateTime}"
										   visible="{parts: ['OperationIsOnCriticalPath', 'UIModel>/showCriticalPath'], formatter: '.formatters.getOnCriticalVisibility'}"/>
						</ordergantt:shapes2>
						<ordergantt:calendars>
							<BaseCalendar id="idCal" shapeId="{CalendarID}" calendarName="{WorkCenterInternalID}" visible="{= ${OrderOperationRowLevel} === 1}"/>
						</ordergantt:calendars>
						<ordergantt:shapes3>
							<BaseDiamond id="idBaseDiamondFinalDue" shapeId="{OrderOperationRowID}" height="{= ${UIModel>/condensedModeActive} ? '15' : '20'}"
										 width="{= ${UIModel>/condensedModeActive} ? '15' : '20'}" hoverable="true"
										 time="{path: 'LatestAcceptableCompletionDate', formatter: '.ganttFormatters.getFinalDueDateStartTime'}" showTitle="false"
										 visible="{parts: ['UIModel>/showFinalDueDate', 'OrderOperationRowLevel', 'LatestAcceptableCompletionDate'], formatter: '.formatters.getFinalDueDateVisibility'}"
										 stroke="@sapNeutralColor" strokeWidth="{= ${UIModel>/condensedModeActive} ? 2 : 3}" fillOpacity="1" fill="@sapUiNeutralBG"
										 tooltip="{path: 'LatestAcceptableCompletionDate', formatter: '.formatters.getFFDMilestoneTitle'}"
										 title="{path: 'LatestAcceptableCompletionDate', formatter: '.formatters.getFFDMilestoneTitle'}"/>
						</ordergantt:shapes3>
						<ordergantt:shapes4>
							<BaseRectangle id="idBaseRectangleWCUtilization" shapeId="{WorkCenterInternalID}" countInBirdEye="true" hoverable="true"
										   visible="{parts: ['WorkCenterUtilization', 'WorkCenterAvailableCapacity', 'WorkCenterRequiredCapacity', 'UIModel>/bUtilizationsToggleBtnOn'], formatter: '.formatters.getVisibilityForUtilization'}"
										   tooltip="{parts: ['WorkCenterUtilization', 'WorkCenterRequiredCapacity', 'WorkCenterAvailableCapacity', 'WorkCenterCapacityUnit'], formatter: '.formatters.getTooltipForUtilization'}"
										   time="{WrkCtrUtilznStartDateTime}"
										   endTime="{WrkCtrUtilznEndDateTime}" yBias="{= ${UIModel>/condensedModeActive} ? -11 : -14}"
										   height="{= ${UIModel>/condensedModeActive} ? '4' : '6'}" showTitle="false"
										   fill="{path:'WorkCenterUtilization', formatter: '.formatters.getUtilizationColor'}"/>
						</ordergantt:shapes4>
						<ordergantt:customShapes6>
							<BaseRectangle id="idOperatoinStartConstraint" shapeId="{OrderOperationRowID}"
										   yBias="{= ${UIModel>/bUtilizationsToggleBtnOn} &amp;&amp; ${UIModel>/showUtilizationIndicator} ? 2 : 0}" fillOpacity="1"
										   visible="{parts: ['UIModel>/showRestrictions', 'OrderOperationRowLevel', 'OrderOpStartConstraintDateTime'], formatter: '.formatters.getOpConstraintVisibility'}"
										   time="{parts: ['OrderOpStartConstraintDateTime', 'OpBscStartDateConstraintType'], formatter: '.formatters.constraintTimeFormatter'}"
										   height="{= ${UIModel>/condensedModeActive} ? '18' : '26'}" xBias="-1" width="2" showTitle="false" hoverable="true"
										   fill="{parts: ['OpBscStartDateConstraintType', 'OrderOpStartConstraintDateTime', 'OrderOperationStartDateTime'], formatter: '.formatters.getOpConstraintFill'}"
										   title="{parts: ['OpBscStartDateConstraintType', 'OrderOpStartConstraintDateTime', 'OrderOperationStartDateTime'], formatter: '.formatters.getStartConstraintTypeText'}"
										   tooltip="{parts: ['OpBscStartDateConstraintType', 'OrderOpStartConstraintDateTime', 'OrderOperationStartDateTime'], formatter: '.formatters.getStartConstraintTypeText'}"/>
						</ordergantt:customShapes6>
						<ordergantt:customShapes7>
							<BaseRectangle id="idOperationActualDate" shapeId="{OrderOperationRowID}"
										   yBias="{parts: ['UIModel>/showUtilizationIndicator', 'UIModel>/condensedModeActive'], formatter: '.formatters.getShowActualDatesYBias'}"
										   time="{OpActualExecutionStartDateTime}"
										   visible="{parts: ['OrderOperationRowLevel', 'ProcessingStatus', 'UIModel>/showActualDates'], formatter: '.formatters.getShowActualDatesVisibility'}"
										   endTime="{OpActualExecutionEndDateTime}"
										   height="{parts: ['UIModel>/condensedModeActive'], formatter: '.formatters.getShowActualDatesHeight'}" showTitle="false" hoverable="true"
										   strokeWidth="1" stroke="@sapContent_BadgeTextColor" fill="@sapPositiveColor"
										   tooltip="{parts: ['ActualWorkQuantity', 'RemainingWorkQuantity'], formatter:'.ganttFormatters.getActualDatesTooltip'}"/>
						</ordergantt:customShapes7>
						<ordergantt:relationships>
							<Relationship id="idRelationshipOperation"
										  shapeId="{parts: ['PredecessorOrderOperationRowID','SuccessorOrderOperationRowID', 'NetworkActivityRelationType'], formatter: '.formatters.getShapeId'}"
										  predecessor="{PredecessorOrderOperationRowID}" successor="{SuccessorOrderOperationRowID}" type="{NetworkActivityRelationType}"
										  lShapeForTypeFS="false" lShapeForTypeSF="false"
										  selectedStroke="sapUiInformative"
										  tooltip="{parts: ['NetworkActivityRelationType','PredecessorOrder','PredecessorOrderOperation','SuccessorOrder','SuccessorOrderOperation','RelationshipIsViolated'], formatter:'.formatters.getRelationToolTip'}"
										  stroke="{parts: ['RelationshipIsExplicit','RelationshipIsViolated'], formatter: '.formatters.getStrokeFill'}"
										  enableCurvedEdge="{= ${RelationshipIsExplicit} === 'X' ? true : false}" selectable="{= ${RelationshipIsExplicit} === 'X' ? true : false}"
										  strokeWidth="{= ${RelationshipIsExplicit} === 'X' ? 2 : 1}" strokeDasharray="{= ${RelationshipIsExplicit} === 'X' ? '0' : '5 10'}"
										  strokeOpacity="{parts: ['RelationshipIsExplicit', 'UIModel>/showImpRel', 'UIModel>/showExpRel', 'UIModel>/bRelationshipsToggleBtnOn'], formatter: '.formatters.getRelVisibility'}"/>
						</ordergantt:relationships>
					</ordergantt:CustomRowSettings>
				</table:rowSettingsTemplate>
				<!-- Columns declaration -->
				<table:columns>
					<table:Column id="idOrderDescColumn" label="{i18n>treeColumnMaintenanceOrder}" sortProperty="MaintenanceOrder" width="40%" visible="true">
						<table:template>
							<m:HBox id="idIconLinkHL" alignItems="Center">
								<core:Icon id="iconid" busy="false" busyIndicatorDelay="1000" visible="true" alt="{MaintenanceOrderDesc}"
										   src="{path: 'OrderOperationRowLevel' , formatter: '.commonFormatters.imageOrder'}" color="Neutral" decorative="true" useIconTooltip="true"
										   noTabStop="false" class="sapUiTinyMarginEnd" tooltip="{path: 'OrderOperationRowLevel' , formatter: '.commonFormatters.imageTooltip'}"/>
								<navpopover:SmartLink
										   id="idOrdOpLink"
										   text="{parts:['OrderOperationRowLevel','MaintenanceOrder','MaintenanceOrderOperation','MaintenanceOrderSubOperation'], formatter:'.formatters.formatOrderOpsLink'}"
										   semanticObject="{path:'OrderOperationRowLevel', formatter:'.formatters.getOrderOpsSemanticObject'}"
										   additionalSemanticObjects="{path:'OrderOperationRowLevel', formatter:'.formatters.getOrderOpsAdditionalSemanticObject'}"
										   fieldName="{path:'OrderOperationRowLevel', formatter:'.formatters.getOrderOpsFieldName'}"
										   navigationTargetsObtainedCallback=".onOrderOpNavigationTargetsObtainedCallback"/>
								<m:Text id="idOrdOpText" wrapping="false" class="sapUiTinyMarginBegin"
										text="{parts:['OrderOperationRowLevel','MaintenanceOrderDesc','OperationDescription','MaintenanceOrderSubOperation'], formatter:'.formatters.formatOrderOpsText'}"></m:Text>
							</m:HBox>
						</table:template>
					</table:Column>
					<table:Column id="idWCColumn" label="{/#C_RSHOrdersAndOperationsType/MainWorkCenter/@sap:label}" sortProperty="MainWorkCenter" width="20%"
								  visible="true">
						<table:template>
							<m:Text id="idWCLabel" text="{MainWorkCenter}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column id="idPriorityColumn" label="{i18n>treeColumnMainPriority}" sortProperty="MaintPriority" width="20%" visible="true">
						<table:template>
							<m:Text id="idMaintPrioLabel" text="{MaintPriorityDesc}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column id="idStatusColumn" label="{i18n>treeColumnProcessingStatus}" sortProperty="ProcessingStatus" width="20%" visible="true">
						<table:template>
							<m:ObjectStatus id="idProcStatusObjStatus" text="{ProcessingStatusText}"
											state="{path: 'ProcessingStatus', formatter: '.commonFormatters.statusColor'}"/>
						</table:template>
					</table:Column>
					<table:Column id="idOrderTypeColumn" label="{/#C_RSHOrdersAndOperationsType/OrderType/@sap:label}" visible="false" sortProperty="OrderType"
								  width="20%">
						<table:template>
							<m:Text id="idOrdTypeLabel" text="{OrderType}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column id="idMaintenanceActivityTypeNameColumn" label="{/#C_RSHOrdersAndOperationsType/MaintenanceActivityType/@sap:label}"
								  visible="false" sortProperty="MaintenanceActivityType" width="20%">
						<table:template>
							<m:Text id="idActTypeLabel"
									text="{parts: ['MaintenanceActivityType' , 'MaintenanceActivityTypeName'], formatter: '.formatters.formatActivityType'}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column id="idControllingAreaColumn" label="{/#C_RSHOrdersAndOperationsType/ControllingArea/@sap:label}" visible="false"
								  sortProperty="ControllingArea" width="20%">
						<table:template>
							<m:Text id="idContrAreaLabel" text="{ControllingArea}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column id="idFunctionalLocationColumn" sortProperty="FunctionalLocationName" width="20%" visible="true">
						<m:Text id="idFunctionalLocationColText" text="{i18n>treeColumnFunctionalLocation}" wrapping="false"/>
						<table:template>
							<navpopover:SmartLink
								id="idFuncLocLink"
								text="{parts: ['FunctionalLocation','FunctionalLocationName']}"
								semanticObject="MaintenanceObject"
								fieldName="{= ${OrderOperationRowLevel} === 1 ? 'RelevantOperationFuncLocation' : 'RelevantFunctionalLocation'}"
							    navigationTargetsObtainedCallback=".onFuncLocNavigationTargetsObtainedCallback"/>
						</table:template>
					</table:Column>
					<table:Column id="idEquipmentNameColumn" visible="false" sortProperty="EquipmentName" width="20%">
						<m:Text id="idEquipmentNameColText" text="{i18n>treeColumnEquipment}" wrapping="false"/>
						<table:template>
							<navpopover:SmartLink
								id="idEquipmentLink"
								text="{parts: ['Equipment','EquipmentName']}"
								semanticObject="MaintenanceObject"
								fieldName="{= ${OrderOperationRowLevel} === 1 ? 'OpEquipmentInternalNumber' : 'EquipmentInternalNumber'}"
								navigationTargetsObtainedCallback=".onEquipmentNavigationTargetsObtainedCallback"/>
						</table:template>
					</table:Column>
					<table:Column id="idLocationColumn" label="{/#C_RSHOrdersAndOperationsType/AssetLocation/@sap:label}" visible="false"
								  sortProperty="AssetLocation" width="20%">
						<table:template>
							<m:Text id="idAssetLocLabel" text="{AssetLocation}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column id="idMaintenancePlannerColumn" label="{/#C_RSHOrdersAndOperationsType/MaintenancePlannerGroup/@sap:label}" visible="false"
								  sortProperty="MaintenancePlannerGroup" width="20%">
						<table:template>
							<m:Text id="idMaintPlannerGrpLabel" text="{MaintenancePlannerGroup}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column id="idMaintenancePlanColumn" label="{/#C_RSHOrdersAndOperationsType/MaintenancePlan/@sap:label}" visible="false"
								  sortProperty="MaintenancePlan" width="20%">
						<table:template>
							<m:Text id="idMaintPlanLabel" text="{MaintenancePlan}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column id="idMaintenancePlantColumn" label="{/#C_RSHOrdersAndOperationsType/MaintenancePlant/@sap:label}" visible="false"
								  sortProperty="MaintenancePlant" width="20%">
						<table:template>
							<m:Text id="idMaintPlantLabel" text="{MaintenancePlant}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column id="idMaterialStatusColumn" label="{/#C_RSHOrdersAndOperationsType/MaterialStatus/@sap:label}" visible="false"
								  sortProperty="MaterialStatusText" width="20%">
						<table:template>
							<m:ObjectStatus id="idMatStatusObjStatus" text="{MaterialStatusText}"
											state="{path: 'MaterialStatus', formatter: '.commonFormatters.materialStatusColor'}"/>
						</table:template>
					</table:Column>
					<table:Column id="idRespCostCenterColumn" label="{/#C_RSHOrdersAndOperationsType/ResponsibleCostCenter/@sap:label}" visible="false"
								  sortProperty="ResponsibleCostCenter" width="20%">
						<table:template>
							<m:Text id="idRespCCLabel" text="{ResponsibleCostCenter}" wrapping="false"/>
						</table:template>
					</table:Column>
					<table:Column id="idMaintRevisionColumn" label="{/#C_RSHOrdersAndOperationsType/MaintenanceRevision/@sap:label}" visible="false"
								  sortProperty="MaintenanceRevision" width="20%">
						<table:template>
							<m:VBox>
								<navpopover:SmartLink id="idMaintRevSmartLink"
									visible="{= ${MaintPlanningBucketUUID} !== '00000000-0000-0000-0000-000000000000'}"
									text="{MaintenanceRevision}"
									semanticObject="MaintenancePlanningBucket"
									fieldName="MaintenanceRevision"
									navigationTargetsObtainedCallback=".onMaintEventNavigationTargetsObtainedCallback" />
								<m:Link id="idMaintRevLink"
									visible="{= ${MaintPlanningBucketUUID} === '00000000-0000-0000-0000-000000000000'}"
									text="{MaintenanceRevision}"
									press="onMaintEventLinkPress" />
							</m:VBox>
						</table:template>
					</table:Column>
					<table:Column id="idRoomColumn" label="{/#C_RSHOrdersAndOperationsType/AssetRoom/@sap:label}" visible="false" sortProperty="AssetRoom"
